# Unity .gitignore
# Source: adapted from https://github.com/github/gitignore/blob/main/Unity.gitignore

# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emory[Cc]aptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# [Aa]ssets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / MonoDevelop / Consulo
.vs/
.consulo/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.VC.VC.opendb

# VSCode
.vscode/
.history/

# Gradle (Android)
.gradle/
*/gradle/wrapper/gradle-wrapper.jar
gradle-app.setting
gradle-wrapper.jar
gradle-wrapper.properties
*/gradlew
*/gradlew.bat
*.gradle
local.properties

# Android builds
*.apk
*.aab
*.ap_

# iOS/Xcode
DerivedData/
*.xccheckout
*.xcworkspace
*.xcuserstate
*.xcscheme
*.xcscmblueprint
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/xcshareddata/WorkspaceSettings.xcsettings

# Addressables (build artifacts)
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/Windows/
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/Android/
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/iOS/
[Aa]ssets/[Ss]treaming[Aa]ssets/aa.meta
[Aa]ssets/[Ss]treaming[Aa]ssets/aa/

# Crash/Reports
CrashReports/

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?
ehthumbs.db
Thumbs.db

# Unity cache files
SysInfo.txt
*.mmdb

